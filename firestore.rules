rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Connection Test ---
    match /test/connection {
      allow read: if true;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function userExists() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function getUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }

    function isEmailAdmin(email) {
      return email != null && email.lower() in [
        'charliemignonette@gmail.com',
        'beeohend@gmail.com',
        'ardeleon.mharsmc@gmail.com',
        'isabelle.p@example.com',
        'pharmacy@mharsmc.doh.gov.ph',
        'alleiagurl@gmail.com',
        'mharsmc.hipc@gmail.com',
        'mharmc.hipc@gmail.com',
        'seanchaves86@gmail.com'
      ];
    }

    function isEmailIPCN(email) {
      return email != null && email.lower() in [
        'bjponz.22.bp@gmail.com', 'belzarinojrmacamay@gmail.com', 'maryjoy.jokjok13@gmail.com',
        'noerensolitana@gmail.com', 'febemaecoronel@gmail.com', 'snmanugas@gmail.com',
        'alcyanide88@gmail.com', 'junedeenmae25@gmail.com', 'krizeljumalon@gmail.com',
        'adelouie.dico178@gmail.com', 'jadelouie.dico178@gmail.com', 'doc.julierose@gmail.com',
        'bayeng.ai@gmail.com', 'kalvien.rn86@gmail.com'
      ];
    }

    function isEmailPharmacy(email) {
      return email != null && email.lower() in [
        'pharmacy@mharsmc.doh.gov.ph', 'salllydinesiso@gmail.com', 'mharsmcpharmacy@gmail.com', 'aedmilaobangs@gmail.com'
      ];
    }

    function isEmailApprover(email) {
      return email != null && email.lower() in [
        'doc.julierose@gmail.com'
      ];
    }

    function isAdmin() { 
      return isSignedIn() && (
        isEmailAdmin(request.auth.token.email) || (userExists() && getUser().get('role', '') == 'ADMIN')
      ); 
    }
    function isIPCN() { 
      return isSignedIn() && (
        isAdmin() || 
        isEmailIPCN(request.auth.token.email) ||
        (userExists() && getUser().get('role', '') == 'IPCN')
      ); 
    }
    function isPharmacy() { 
      return isSignedIn() && (
        isAdmin() || 
        isEmailPharmacy(request.auth.token.email) ||
        (userExists() && getUser().get('role', '') == 'PHARMACY')
      ); 
    }
    function isApprover() { 
      return isSignedIn() && (
        isAdmin() || 
        isIPCN() || 
        isEmailApprover(request.auth.token.email) ||
        (userExists() && (getUser().get('role', '') == 'APPROVER' || getUser().get('role', '') == 'PHYSICIAN'))
      ); 
    }

    function isEmailAuthorizedForRole(email, role) {
      return (role == 'ADMIN' && isEmailAdmin(email)) ||
      (role == 'IPCN' && isEmailIPCN(email)) ||
      (role == 'APPROVER' && isEmailApprover(email)) ||
      (role == 'PHARMACY' && isEmailPharmacy(email)) ||
      (role == 'USER' || role == 'PHYSICIAN');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isValidString(val, max) { return val is string && val.size() <= max; }

    function isOwner(reporterIdField) {
      return isSignedIn() && reporterIdField == request.auth.uid;
    }

    function isWardStaffOrOwner(prescriberId, unit) {
      return isOwner(prescriberId) || (userExists() && getUser().get('isAnonymous', false) == true && unit != null && unit == getUser().get('unit', ''));
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return (!('uid' in data) || data.uid == request.auth.uid) &&
             (!('role' in data) || data.role in ['ADMIN', 'IPCN', 'PHYSICIAN', 'PHARMACY', 'APPROVER', 'USER']);
    }

    function isValidAudit(data) {
      return (!('score' in data) || data.score is number) &&
             (!('total' in data) || data.total is number) &&
             (!('unit' in data) || isValidString(data.unit, 100));
    }

    function isValidAntimicrobialReq(data) {
      return (!('type' in data) || data.type is string) &&
             (!('status' in data) || data.status in ['PENDING', 'APPROVED', 'DENIED', 'DISPENSED', 'MODIFY']) &&
             (!('patientName' in data) || isValidString(data.patientName, 256)) &&
             (!('antibiotic' in data) || isValidString(data.antibiotic, 256));
    }

    function isValidNSIRep(data) {
      return (!('status' in data) || data.status in ['PENDING', 'VALIDATED', 'CLOSED']);
    }

    function isValidHAICase(data) {
      return (!('patientName' in data) || isValidString(data.patientName, 100)) &&
             (!('hospNo' in data) || isValidString(data.hospNo, 128));
    }

    function isValidBOCLog(data) {
      return true;
    }

    function isValidOutbreak(data) {
      return (!('status' in data) || data.status in ['Suspected', 'Under Investigation', 'Confirmed', 'Controlled', 'Closed']);
    }

    function isValidBundleMonitoring(data) {
      return (!('hospitalNo' in data) || isValidString(data.hospitalNo, 128)) &&
             (!('patientName' in data) || isValidString(data.patientName, 128));
    }

    // --- Collection Routes ---

    match /user_roles/{roleId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && (userId == request.auth.uid) && isValidUser(incoming()) && (
        incoming().get('role', 'USER') == 'USER' ||
        (request.auth.token.email != null && isEmailAuthorizedForRole(request.auth.token.email, incoming().get('role', 'USER')))
      );
      allow update: if isSignedIn() && (userId == request.auth.uid || isAdmin()) && 
                    isValidUser(incoming()) && (
                      (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'unit', 'staffCode', 'role', 'updatedAt', 'isVerified']) && (
                        incoming().get('role', 'USER') == existing().get('role', 'USER') || 
                        incoming().get('role', 'USER') == 'USER' || 
                        isAdmin() ||
                        (request.auth.token.email != null && isEmailAuthorizedForRole(request.auth.token.email, incoming().get('role', 'USER')))
                      ))
                    );
      allow list: if isAdmin() || isIPCN();
    }

    match /audits/{auditId} {
      allow get: if isSignedIn() && (existing().get('auditorId', '') == request.auth.uid || isIPCN() || isAdmin());
      allow list: if isSignedIn() && (resource.data.get('auditorId', '') == request.auth.uid || isIPCN() || isAdmin());
      allow create: if isSignedIn() && isValidAudit(incoming()) && incoming().get('auditorId', '') == request.auth.uid && isValidId(auditId);
      allow update: if (isIPCN() || isAdmin()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status', 'isValidated', 'validatedBy', 'validatedAt', 'validatorName', 'reason', 'notes', 
                      'basis', 'rootCauses', 'contributingFactors', 'correctiveActions', 'classification', 
                      'monitoringMethod', 'monitoringStatus', 'clinicalAccuracy', 'complianceAccuracy', 
                      'validationRemarks', 'date', 'time', 'updatedAt'
                    ]);
      allow delete: if isAdmin() || isIPCN();
    }

    match /nsi_reports/{reportId} {
      allow get: if isSignedIn() && (existing().get('reporterId', '') == request.auth.uid || isIPCN() || isAdmin());
      allow list: if isSignedIn() && (resource.data.get('reporterId', '') == request.auth.uid || isIPCN() || isAdmin());
      allow create: if isSignedIn() && isValidNSIRep(incoming()) && incoming().get('reporterId', '') == request.auth.uid && incoming().get('status', 'PENDING') == 'PENDING' && isValidId(reportId);
      allow update: if (isIPCN() || isAdmin()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status', 'validation', 'isValidated', 'validatedBy', 'validatedAt', 'validatorName', 
                      'updatedAt', 'notes', 'reason', 'basis', 'rootCauses', 'contributingFactors', 
                      'correctiveActions', 'classification', 'monitoringMethod', 'monitoringStatus', 
                      'clinicalAccuracy', 'complianceAccuracy'
                    ]);
      allow delete: if isAdmin() || isIPCN();
    }

    match /ams_requests/{reqId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isAdmin() || isIPCN() || existing().get('prescriberId', '') == request.auth.uid);
    }

    match /hai_cases/{caseId} {
      allow get: if isSignedIn() && (existing().get('auditorId', '') == request.auth.uid || isIPCN() || isAdmin());
      allow list: if isSignedIn() && (resource.data.get('auditorId', '') == request.auth.uid || isIPCN() || isAdmin());
      allow create: if isSignedIn() && isValidHAICase(incoming()) && isValidId(caseId);
      allow update: if isSignedIn() && (isAdmin() || isIPCN() || (
                   existing().get('auditorId', '') == request.auth.uid &&
                   incoming().diff(existing()).affectedKeys().hasOnly([
                     'status', 'validatedBy', 'validatedAt', 'validatorName', 'isValidated', 'decisionNote', 
                     'reason', 'notes', 'basis', 'rootCauses', 'contributingFactors', 'correctiveActions', 
                     'classification', 'validationResult', 'monitoringMethod', 'monitoringStatus', 'date', 
                     'time', 'updatedAt', 'deviceDays', 'riskLevel', 'clinicalAccuracy', 'complianceAccuracy', 
                     'validationRemarks', 'correctedDeviceDays', 'correctedRiskLevel', 'clabsiValidationDetails', 'cautiValidationDetails', 'ssiValidationDetails', 'vaeValidationDetails'
                   ])));
      allow delete: if isAdmin() || isIPCN();
    }

    match /boc_logs/{logId} {
      allow get: if isSignedIn() && (existing().get('staffId', '') == request.auth.uid || isIPCN() || isAdmin());
      allow list: if isSignedIn() && (resource.data.get('staffId', '') == request.auth.uid || isIPCN() || isAdmin());
      allow create: if isSignedIn() && isValidBOCLog(incoming()) && incoming().get('staffId', '') == request.auth.uid && isValidId(logId);
      allow update: if (isIPCN() || isAdmin()) && 
                   incoming().diff(existing()).affectedKeys().hasOnly(['isValidated', 'verification', 'validatedBy', 'validatedAt', 'validatorName', 'status', 'reason', 'notes', 'basis', 'rootCauses', 'contributingFactors', 'correctiveActions', 'classification', 'monitoringMethod', 'monitoringStatus', 'clinicalAccuracy', 'complianceAccuracy', 'validationRemarks', 'date', 'time', 'updatedAt']);
      allow delete: if isAdmin() || isIPCN();
    }

    match /bundle_monitorings/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidBundleMonitoring(incoming()) && incoming().get('staffId', '') == request.auth.uid && isValidId(id);
      allow update: if isSignedIn() && (
        isAdmin() || isIPCN() || 
        (existing().get('staffId', '') == request.auth.uid && 
         incoming().diff(existing()).affectedKeys().hasOnly([
           'monitoringDays', 'updatedAt', 'status', 'assignedDoctor', 'devices', 'surgery', 
           'hasUnverifiedDays', 'isValidated', 'validatedBy', 'validatorName', 'validatedAt',
           'endMonitoring', 'endMonitoringDateTime', 'endMonitoringReason', 'endedByAdmin',
           'patientName', 'hospitalNo', 'unit', 'bedNumber', 'age', 'sex', 'roomWard', 'attendingPhysician', 
           'assignedMonitor', 'staffName', 'staffId', 'createdAt',
           'isFlaggedPossibleHAI', 'latestTriggerReason', 'latestTriggerDateTime', 'latestTriggeredBy',
           'isVerifiedByIPCU', 'verifiedAtIPCU', 'verifiedByIPCUId', 'verifiedByIPCUName', 'verificationNote', 'clinicalAccuracy', 'complianceAccuracy'
         ]))
      );
      allow delete: if isAdmin() || isIPCN() || existing().get('staffId', '') == request.auth.uid;
    }

    match /outbreaks/{outbreakId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidOutbreak(incoming()) && incoming().get('reporterId', '') == request.auth.uid && incoming().get('status', 'Suspected') == 'Suspected' && isValidId(outbreakId);
      allow update: if (isIPCN() || isAdmin() || isOwner(existing().get('reporterId', '')) || !('reporterId' in existing()));
      allow delete: if isAdmin() || isIPCN() || (isOwner(existing().get('reporterId', '')) && existing().get('status', '') == 'Suspected');
    }

    match /validation_logs/{logId} {
      allow get, list: if isIPCN() || isAdmin();
      allow create: if isIPCN() || isAdmin();
      allow delete: if isAdmin() || isIPCN();
    }

    match /ipcu_actions/{actionId} {
      allow get, list: if isSignedIn() && (existing().get('staffId', '') == request.auth.uid || isIPCN() || isAdmin());
      allow create: if isIPCN() || isAdmin();
      allow delete: if isAdmin();
    }

    match /hai_denominators/{id} {
      allow read: if isSignedIn();
      allow write: if isIPCN();
    }
    
    match /quality_goals/{monthId} {
      allow read: if isSignedIn();
      allow write: if isIPCN() || isAdmin();
    }
  }
}
